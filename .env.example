# Copy to .env (git-ignored) and fill in. Never commit real keys; a pre-commit hook blocks them.

# Which model provider to use: anthropic | openai | azure-openai | litellm | bedrock
UPSHIFT_PROVIDER=anthropic
# Model name. Anthropic defaults to claude-opus-5-5; for Azure OpenAI this is your deployment name.
UPSHIFT_MODEL=

# anthropic
ANTHROPIC_API_KEY=

# azure-openai
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
OPENAI_API_VERSION=2024-10-21

# litellm: the neatHack model proxy by default (models: claude-opus-4.6, claude-sonnet-4.6, claude-haiku,
# nova-pro, nova-lite, nova-2-lite, nova-micro). Set LITELLM_BASE_URL for another LiteLLM proxy.
LITELLM_API_KEY=
LITELLM_BASE_URL=

# openai (or any OpenAI-compatible service via OPENAI_BASE_URL)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# bedrock (an explicit profile is required; the default profile is never used)
UPSHIFT_AWS_PROFILE=
UPSHIFT_AWS_REGION=us-west-2

# neatlogs project key. Without it, spans are created but not exported.
NEATLOGS_API_KEY=

# Tag runs so traces can be compared (v0 before improvements, v1 after).
UPSHIFT_AGENT_VERSION=v0
